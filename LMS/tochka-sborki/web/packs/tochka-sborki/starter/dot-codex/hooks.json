{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/session-start.mjs",
            "statusMessage": "Память проекта: STATE.md и TODO.md",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
