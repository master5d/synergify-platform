  "outline": [
    {
      "heading": "Five sins of prompting",
      "points": [],
      "children": [
        {
          "heading": "Context Rot",
          "points": [
            {
              "text": "The longer the conversation, the worse the model handles early information.",
              "origin": "extract"
            }
          ],
          "children": []
        },
        {
          "heading": "Lost in the Middle",
          "points": [
            {
              "text": "The model over-weights the beginning and end of the context.",
              "origin": "extract"
            }
          ],
          "children": []
        },
        {
          "heading": "Distractors — extra stuff pulls attention",
          "points": [
            {
              "text": "Similar fragments in the context throw the model off the correct answer.",
              "origin": "extract"
            }
          ],
          "children": []
        },
        {
          "heading": "Mixing context and prompt",
          "points": [
            {
              "text": "Context (who you are, what's going on) and instruction (what to do specifically) are different things.",
              "origin": "extract"
            }
          ],
          "children": []
        },
        {
          "heading": "Aggressive tone instead of a correction",
          "points": [
            {
              "text": "Research disagrees on how rudeness affects the answer.",
              "origin": "extract"
            }
          ],
          "children": []
        }
      ]
    }
  ],
