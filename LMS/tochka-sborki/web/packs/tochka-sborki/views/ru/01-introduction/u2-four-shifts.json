      ],
      "children": [
        {
          "heading": "1️⃣ От команд → к делегированию",
          "points": [
            {
              "text": "Агент — не робот, которому даёшь команды.",
              "origin": "extract"
            }
          ],
          "children": []
        },
        {
          "heading": "2️⃣ От результата → к эксперименту",
          "points": [
            {
              "text": "Первый ответ — черновик, не приговор.",
              "origin": "extract"
